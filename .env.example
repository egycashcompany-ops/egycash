# ECMS environment configuration.
# Every variable is validated by the Zod env schema at boot (apps/api/src/infrastructure/config/env.ts).
# Copy to .env for local development — the defaults below work with `docker compose up -d`.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Data stores ────────────────────────────────────────────────────────────
# Local docker-compose runs a single-node replica set (required for transactions).
MONGO_URI=mongodb://localhost:27017/ecms?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# ── Auth (ADR-006) ─────────────────────────────────────────────────────────
# Generate real secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# Set true behind HTTPS (staging/production).
COOKIE_SECURE=false

# ── HTTP ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Observability ──────────────────────────────────────────────────────────
# Error tracking (Review R31). Leave empty to disable.
SENTRY_DSN=
# Slow-query telemetry threshold in ms (Review R30).
SLOW_QUERY_MS=200

# ── Seed data (development only — synthetic, never production values) ──────
SEED_ADMIN_EMAIL=admin@ecms.local
SEED_ADMIN_PASSWORD=Admin#2026!ecms
SEED_HR_EMAIL=hr@ecms.local
SEED_HR_PASSWORD=HrUser#2026!ecms

# ── HR-only accounts (apps/api/src/hr-only-access.ts) ──────────────────────
# Accounts confined to the HR module: no permission outside HR, no non-HR module in their
# navigation, and TOTP explicitly off. Re-asserted on every seed and every API start.
# Comma-separated EMAILS or USERNAMES — the two identifiers this system holds unique.
# The four accounts below are the shipped default (see env.ts); set this only to override them,
# or set it empty for a deployment these people do not belong to.
HR_ONLY_USER_IDENTIFIERS=mohamed.mustafa@egycash.com.eg,samer.mohammed@egycash.com.eg,mohamed.essam@egycash.com.eg,saif.aldin@egycash.com.eg
# Fallback for a database whose logins are not known yet: allows `name:<full English name>`
# entries above, matched case-insensitively against `firstName.en lastName.en`. Off by design —
# a display name is not unique, and even enabled a name matching two accounts is refused.
HR_ONLY_ALLOW_NAME_IDENTIFIERS=false

# ── Frontend (apps/web, Vite) ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ── File storage (ADR-010, Sprint 3.1) ─────────────────────────────────────
# Driver: local | railway | s3 | minio | azure
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
# Set automatically by Railway when a volume is attached (driver: railway).
RAILWAY_VOLUME_MOUNT_PATH=
# HMAC secret for app-signed download URLs (openssl rand -hex 32).
STORAGE_SIGNING_SECRET=dev-only-file-signing-secret
# Hand the browser the object store's own presigned URL (absolute, on the store's origin) instead
# of this app's signed endpoint. Leave false unless the deployed Content-Security-Policy actually
# allows that origin — otherwise the browser silently refuses every stored image.
STORAGE_PRESIGNED_URLS=false
SIGNED_URL_TTL_SECONDS=300
# Absolute base URL of the api — used in app-signed download URLs.
API_PUBLIC_URL=http://localhost:3000
# Platform-wide upload cap; categories can only tighten it.
MAX_UPLOAD_MB=25
# S3 / MinIO (driver: s3 | minio; MinIO also requires S3_ENDPOINT)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Azure Blob (driver: azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=ecms-files

# ── National-ID OCR (OQ-30) ──────────────────────────────────────────────────
# The local, offline OCR sidecar. LEAVE UNSET to keep the null stub: the endpoint
# answers `available: false` and applicants are entered manually, which is the
# default everywhere. Set it only where the `nid-ocr` container actually runs:
#
#   cd spikes/national-id-ocr && docker build -t ecms/nid-ocr:latest .
#   docker run --rm -p 127.0.0.1:8099:8099 ecms/nid-ocr:latest
#
# NATIONAL_ID_OCR_URL=http://localhost:8099
# NATIONAL_ID_OCR_TIMEOUT_MS=20000

# ── ATM maintenance mailbox (ATM-6) ──────────────────────────────────────────
# The ONE central reader that replaces the legacy per-branch mail services. LEAVE
# UNSET to keep the null source: the `atm.mailPoll` task finds no mailbox and does
# nothing, which is every install that has no mailbox.
#
# Classification is not configured here — the machine decides the branch. A mail
# names a machine code; the machine names its branch; the ticket is filed there.
# The per-branch mailbox COLOUR is the `atm.mail.branchCategories` setting.
#
# The client secret takes plaintext, or a JSON SecretRef the platform store opens.
#
# ATM_MAIL_GRAPH_TENANT_ID=
# ATM_MAIL_GRAPH_CLIENT_ID=
# ATM_MAIL_GRAPH_CLIENT_SECRET=
# ATM_MAIL_GRAPH_USER=atm-alerts@egycash.example
# ATM_MAIL_GRAPH_TIMEOUT_MS=20000

# ── Automation Engine (ADR-018) ──────────────────────────────────────────────
# OFF by default. With AUTOMATION_ENABLED=false the null provider stays active,
# dispatches record `skipped`, and nothing about the deployment changes.
# AUTOMATION_ENABLED=false
# AUTOMATION_PROVIDER=null      # or `n8n`

# ── n8n provider (A-5 trigger path) ──────────────────────────────────────────
# The trigger bridge sends authenticated HTTP requests to n8n. Nothing is
# hardcoded — set N8N_BASE_URL to enable it. BOTH the URL and the API key are
# required; miss either and the provider declines to register (logs a warning,
# stays on the null provider) so a business transaction never fails over config.
# The API and the WORKER must share these values.
#
#   AUTOMATION_ENABLED=true
#   AUTOMATION_PROVIDER=n8n
#   N8N_BASE_URL=https://n8n-production-b24c.up.railway.app   # no trailing slash
#   N8N_API_KEY=                 # REQUIRED; sent as X-N8N-API-KEY, never logged
#   N8N_TIMEOUT_MS=30000         # per-request budget; a stuck n8n degrades one trigger
#   N8N_MAX_RETRIES=2            # transport-failure retries inside one dispatch (BullMQ retries on top)
#   N8N_WEBHOOK_SECRET=          # optional; per-workflow trigger signatures are derived from it
#                                # (X-ECMS-Signature) so n8n can reject anything not from ECMS
#
# Verify an instance satisfies the authoring contract before pointing production at it:
#   N8N_BASE_URL=... N8N_API_KEY=... npm run check:n8n

# ── Web Push (the `push` notification channel) ────────────────────────────────
#
# Generate a pair ONCE per deployment and keep the private key secret:
#
#   npx web-push generate-vapid-keys
#
# BOTH EMPTY IS A WORKING STATE, and the default. With no pair the push channel
# reports itself unconfigured: no notification is ever given a push row, no
# browser is asked for a permission it would have nothing to receive on, and the
# preferences page says the server has not set it up rather than showing a switch
# that cannot work. Dev and CI need nothing here.
#
# A HALF pair fails the boot on purpose — one key without the other is a typo or a
# half-finished secrets copy, never a decision, and the failure it causes otherwise
# is a web-push error inside a worker retry hours after the deploy.
#
#   VAPID_PUBLIC_KEY=            # the browser holds this one; it is public by design
#   VAPID_PRIVATE_KEY=           # secret — signs every push this server sends
#   VAPID_SUBJECT=mailto:egycash.company@gmail.com   # how a push service reaches a human here
#
# Push needs HTTPS (or localhost), and on iPhone/iPad it reaches only a PWA that has
# been added to the Home Screen — a plain Safari tab cannot receive one.

# ── Realtime screens (ADR-029) ────────────────────────────────────────────────
# Live entity-change signals over the same Socket.IO server the notification
# bell uses. ON by default. Turning it off restores pre-realtime behaviour
# exactly — screens refresh on navigation and staleness only — and is safe to
# flip in production at any time; clients fall back without a redeploy.
#
# REALTIME_ENABLED=true
