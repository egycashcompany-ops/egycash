{
  "key": "account-credentials-reissued",
  "version": "1.0.0",
  "name": {
    "en": "Credentials reissued follow-up",
    "ar": "متابعة إعادة إصدار بيانات الدخول"
  },
  "category": "identity",
  "description": {
    "en": "An admin reset an account: ECMS issued a fresh one-time setup link, revoked every session and re-armed the change gate. A reset means someone is locked out NOW, so this checks the delivery outcome immediately, reminds after 6h and escalates after 24h. Like the activation workflow, it never handles the token — ECMS re-sends.",
    "ar": "قام أحد المسؤولين بإعادة تعيين حساب: أصدر ECMS رابط إعداد جديد لمرة واحدة، وألغى كل الجلسات، وأعاد تفعيل بوابة تغيير كلمة المرور. إعادة التعيين تعني أن هناك من هو محجوب عن الدخول الآن، لذلك يفحص هذا الـ workflow نتيجة الإرسال فورًا، ويذكّر بعد ٦ ساعات، ويصعّد بعد ٢٤ ساعة. ولا يتعامل مع الرمز إطلاقًا — ECMS هو من يعيد الإرسال."
  },
  "requires": {
    "events": ["platform.auth.passwordReset"],
    "credentials": [],
    "capabilities": ["visualBuilder"],
    "platform": "^2.2"
  },
  "provider": { "id": "n8n", "minVersion": "1.60.0" },
  "graph": {
    "providerId": "n8n",
    "formatVersion": "1",
    "nodes": {
      "nodes": [
        {
          "id": "cfg-02",
          "name": "ECMS Config",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.4,
          "position": [220, 0],
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "c1",
                  "name": "ecmsApiBase",
                  "value": "https://ecms-api.internal/api/v1",
                  "type": "string"
                },
                { "id": "c2", "name": "requireSignature", "value": true, "type": "boolean" },
                { "id": "c3", "name": "firstReminderHours", "value": 6, "type": "number" },
                { "id": "c4", "name": "escalationHours", "value": 24, "type": "number" },
                {
                  "id": "c5",
                  "name": "deliveryFailedTemplateKey",
                  "value": "platform.credentialsDeliveryFailed",
                  "type": "string"
                },
                {
                  "id": "c6",
                  "name": "escalationTemplateKey",
                  "value": "platform.resetNotUsed",
                  "type": "string"
                },
                { "id": "c7", "name": "escalationRoleKey", "value": "hr-admin", "type": "string" }
              ]
            },
            "options": {}
          }
        },
        {
          "id": "guard-02",
          "name": "Verify + Dedupe",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [440, 0],
          "notes": "Fail-closed: authenticity, envelope shape, idempotency. Needs NODE_FUNCTION_ALLOW_BUILTIN=crypto.",
          "parameters": {
            "mode": "runOnceForAllItems",
            "jsCode": "const crypto = require('crypto');\nconst cfg = $('ECMS Config').first().json;\nconst hook = $('ECMS Trigger').first().json;\nconst body = hook.body || {};\nconst headers = hook.headers || {};\n\nif (cfg.requireSignature) {\n  const secret = $env.ECMS_WEBHOOK_SECRET;\n  const got = headers['x-ecms-signature'];\n  if (!secret) throw new Error('ECMS_WEBHOOK_SECRET is not set on this n8n instance');\n  if (!got) throw new Error('unsigned trigger refused - set N8N_WEBHOOK_SECRET on ECMS');\n  const path = $('ECMS Trigger').params.path;\n  const key = crypto.createHmac('sha256', secret).update(path).digest('hex');\n  const want = 'sha256=' + crypto.createHmac('sha256', key).update(JSON.stringify(body)).digest('hex');\n  const a = Buffer.from(want);\n  const b = Buffer.from(String(got));\n  if (a.length !== b.length || !crypto.timingSafeEqual(a, b)) throw new Error('bad ECMS signature');\n}\n\nfor (const f of ['eventId', 'eventType', 'occurredAt', 'version', 'executionId']) {\n  if (body[f] === undefined) throw new Error('not an ECMS event envelope: missing ' + f);\n}\n\nconst state = $getWorkflowStaticData('global');\nstate.seen = Array.isArray(state.seen) ? state.seen : [];\nif (state.seen.includes(body.eventId)) return [];\nstate.seen.push(body.eventId);\nif (state.seen.length > 500) state.seen = state.seen.slice(-500);\n\n// A reset whose delivery silently failed is the worst case, and it is knowable at t=0.\nconst delivery = Array.isArray(body.payload && body.payload.delivery) ? body.payload.delivery : [];\nconst failed = delivery.filter((d) => d && d.ok === false).map((d) => d.channel);\nreturn [{ json: Object.assign({}, body, { deliveryFailedChannels: failed }) }];"
          }
        },
        {
          "id": "if-03",
          "name": "Delivery failed?",
          "type": "n8n-nodes-base.if",
          "typeVersion": 2.2,
          "position": [660, 0],
          "parameters": {
            "conditions": {
              "options": {
                "caseSensitive": true,
                "leftValue": "",
                "typeValidation": "loose",
                "version": 2
              },
              "conditions": [
                {
                  "id": "i1",
                  "leftValue": "={{ $json.deliveryFailedChannels.length }}",
                  "rightValue": 0,
                  "operator": { "type": "number", "operation": "gt" }
                }
              ],
              "combinator": "and"
            },
            "options": {}
          }
        },
        {
          "id": "notify-02",
          "name": "Alert delivery failure [A-6b]",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [880, -140],
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 5000,
          "credentials": { "httpHeaderAuth": { "name": "ECMS Service Token" } },
          "parameters": {
            "method": "POST",
            "url": "={{ $('ECMS Config').first().json.ecmsApiBase }}/automation/actions/notify",
            "authentication": "genericCredentialType",
            "genericAuthType": "httpHeaderAuth",
            "sendBody": true,
            "specifyBody": "json",
            "jsonBody": "={{ JSON.stringify({ to: { roleKey: $('ECMS Config').first().json.escalationRoleKey }, templateKey: $('ECMS Config').first().json.deliveryFailedTemplateKey, variables: { userId: $('Verify + Dedupe').first().json.payload.userId, channels: $('Verify + Dedupe').first().json.deliveryFailedChannels.join(', ') } }) }}",
            "options": {}
          }
        },
        {
          "id": "wait-03",
          "name": "Wait - first reminder",
          "type": "n8n-nodes-base.wait",
          "typeVersion": 1.1,
          "position": [880, 140],
          "webhookId": "ecms-reissue-wait-1",
          "parameters": {
            "resume": "timeInterval",
            "amount": "={{ $('ECMS Config').first().json.firstReminderHours }}",
            "unit": "hours"
          }
        },
        {
          "id": "read-03",
          "name": "Read user",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [1100, 140],
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 5000,
          "credentials": { "httpHeaderAuth": { "name": "ECMS Service Token" } },
          "parameters": {
            "method": "GET",
            "url": "={{ $('ECMS Config').first().json.ecmsApiBase }}/platform/users/{{ $('Verify + Dedupe').first().json.payload.userId }}",
            "authentication": "genericCredentialType",
            "genericAuthType": "httpHeaderAuth",
            "options": {}
          }
        },
        {
          "id": "if-04",
          "name": "Reset still unused?",
          "type": "n8n-nodes-base.if",
          "typeVersion": 2.2,
          "position": [1320, 140],
          "parameters": {
            "conditions": {
              "options": {
                "caseSensitive": true,
                "leftValue": "",
                "typeValidation": "loose",
                "version": 2
              },
              "conditions": [
                {
                  "id": "i1",
                  "leftValue": "={{ $json.data ? $json.data.accountStatus : $json.accountStatus }}",
                  "rightValue": "activated",
                  "operator": { "type": "string", "operation": "notEquals" }
                }
              ],
              "combinator": "and"
            },
            "options": {}
          }
        },
        {
          "id": "resend-02",
          "name": "Resend credentials",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [1540, 60],
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 5000,
          "notes": "ECMS re-issues and re-sends. The setup token never enters n8n (design W-1).",
          "credentials": { "httpHeaderAuth": { "name": "ECMS Service Token" } },
          "parameters": {
            "method": "POST",
            "url": "={{ $('ECMS Config').first().json.ecmsApiBase }}/platform/users/{{ $('Verify + Dedupe').first().json.payload.userId }}/credentials/resend",
            "authentication": "genericCredentialType",
            "genericAuthType": "httpHeaderAuth",
            "options": {}
          }
        },
        {
          "id": "wait-04",
          "name": "Wait - escalation",
          "type": "n8n-nodes-base.wait",
          "typeVersion": 1.1,
          "position": [1760, 60],
          "webhookId": "ecms-reissue-wait-2",
          "parameters": {
            "resume": "timeInterval",
            "amount": "={{ $('ECMS Config').first().json.escalationHours }}",
            "unit": "hours"
          }
        },
        {
          "id": "read-04",
          "name": "Re-read user",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [1980, 60],
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 5000,
          "credentials": { "httpHeaderAuth": { "name": "ECMS Service Token" } },
          "parameters": {
            "method": "GET",
            "url": "={{ $('ECMS Config').first().json.ecmsApiBase }}/platform/users/{{ $('Verify + Dedupe').first().json.payload.userId }}",
            "authentication": "genericCredentialType",
            "genericAuthType": "httpHeaderAuth",
            "options": {}
          }
        },
        {
          "id": "if-05",
          "name": "Still locked out?",
          "type": "n8n-nodes-base.if",
          "typeVersion": 2.2,
          "position": [2200, 60],
          "parameters": {
            "conditions": {
              "options": {
                "caseSensitive": true,
                "leftValue": "",
                "typeValidation": "loose",
                "version": 2
              },
              "conditions": [
                {
                  "id": "i1",
                  "leftValue": "={{ $json.data ? $json.data.accountStatus : $json.accountStatus }}",
                  "rightValue": "activated",
                  "operator": { "type": "string", "operation": "notEquals" }
                }
              ],
              "combinator": "and"
            },
            "options": {}
          }
        },
        {
          "id": "notify-03",
          "name": "Escalate to HR/IT [A-6b]",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [2420, 0],
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 5000,
          "credentials": { "httpHeaderAuth": { "name": "ECMS Service Token" } },
          "parameters": {
            "method": "POST",
            "url": "={{ $('ECMS Config').first().json.ecmsApiBase }}/automation/actions/notify",
            "authentication": "genericCredentialType",
            "genericAuthType": "httpHeaderAuth",
            "sendBody": true,
            "specifyBody": "json",
            "jsonBody": "={{ JSON.stringify({ to: { roleKey: $('ECMS Config').first().json.escalationRoleKey }, templateKey: $('ECMS Config').first().json.escalationTemplateKey, variables: { userId: $('Verify + Dedupe').first().json.payload.userId, mode: $('Verify + Dedupe').first().json.payload.mode, resetAt: $('Verify + Dedupe').first().json.occurredAt } }) }}",
            "options": {}
          }
        },
        {
          "id": "log-05",
          "name": "Log outcome [A-6b]",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [2640, 140],
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 5000,
          "alwaysOutputData": true,
          "credentials": { "httpHeaderAuth": { "name": "ECMS Service Token" } },
          "parameters": {
            "method": "POST",
            "url": "={{ $('ECMS Config').first().json.ecmsApiBase }}/automation/actions/log",
            "authentication": "genericCredentialType",
            "genericAuthType": "httpHeaderAuth",
            "sendBody": true,
            "specifyBody": "json",
            "jsonBody": "={{ JSON.stringify({ executionId: $('Verify + Dedupe').first().json.executionId, step: 'passwordReset.followUp', status: 'ok' }) }}",
            "options": {}
          }
        }
      ],
      "connections": {
        "ECMS Trigger": { "main": [[{ "node": "ECMS Config", "type": "main", "index": 0 }]] },
        "ECMS Config": { "main": [[{ "node": "Verify + Dedupe", "type": "main", "index": 0 }]] },
        "Verify + Dedupe": {
          "main": [[{ "node": "Delivery failed?", "type": "main", "index": 0 }]]
        },
        "Delivery failed?": {
          "main": [
            [
              { "node": "Alert delivery failure [A-6b]", "type": "main", "index": 0 },
              { "node": "Wait - first reminder", "type": "main", "index": 0 }
            ],
            [{ "node": "Wait - first reminder", "type": "main", "index": 0 }]
          ]
        },
        "Wait - first reminder": {
          "main": [[{ "node": "Read user", "type": "main", "index": 0 }]]
        },
        "Read user": { "main": [[{ "node": "Reset still unused?", "type": "main", "index": 0 }]] },
        "Reset still unused?": {
          "main": [
            [{ "node": "Resend credentials", "type": "main", "index": 0 }],
            [{ "node": "Log outcome [A-6b]", "type": "main", "index": 0 }]
          ]
        },
        "Resend credentials": {
          "main": [[{ "node": "Wait - escalation", "type": "main", "index": 0 }]]
        },
        "Wait - escalation": { "main": [[{ "node": "Re-read user", "type": "main", "index": 0 }]] },
        "Re-read user": { "main": [[{ "node": "Still locked out?", "type": "main", "index": 0 }]] },
        "Still locked out?": {
          "main": [
            [{ "node": "Escalate to HR/IT [A-6b]", "type": "main", "index": 0 }],
            [{ "node": "Log outcome [A-6b]", "type": "main", "index": 0 }]
          ]
        },
        "Escalate to HR/IT [A-6b]": {
          "main": [[{ "node": "Log outcome [A-6b]", "type": "main", "index": 0 }]]
        }
      }
    }
  },
  "changelog": {
    "en": "1.0.0 - first release. Immediate delivery-failure alert, reminder at 6h, escalation at +24h.",
    "ar": "١.٠.٠ - الإصدار الأول. تنبيه فوري عند فشل الإرسال، تذكير بعد ٦ ساعات، تصعيد بعد ٢٤ ساعة."
  }
}
