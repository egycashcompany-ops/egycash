        {
          "id": "guard-03",
          "name": "Verify + Dedupe",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [440, 0],
          "notes": "Fail-closed: authenticity, envelope shape, idempotency. Needs NODE_FUNCTION_ALLOW_BUILTIN=crypto.",
          "parameters": {
            "mode": "runOnceForAllItems",
            "jsCode": "const crypto = require('crypto');\nconst cfg = $('ECMS Config').first().json;\nconst hook = $('ECMS Trigger').first().json;\nconst body = hook.body || {};\nconst headers = hook.headers || {};\n\nif (cfg.requireSignature) {\n  const secret = $env.ECMS_WEBHOOK_SECRET;\n  const got = headers['x-ecms-signature'];\n  if (!secret) throw new Error('ECMS_WEBHOOK_SECRET is not set on this n8n instance');\n  if (!got) throw new Error('unsigned trigger refused - set N8N_WEBHOOK_SECRET on ECMS');\n  const path = $('ECMS Trigger').params.path;\n  const key = crypto.createHmac('sha256', secret).update(path).digest('hex');\n  const want = 'sha256=' + crypto.createHmac('sha256', key).update(JSON.stringify(body)).digest('hex');\n  const a = Buffer.from(want);\n  const b = Buffer.from(String(got));\n  if (a.length !== b.length || !crypto.timingSafeEqual(a, b)) throw new Error('bad ECMS signature');\n}\n\nfor (const f of ['eventId', 'eventType', 'occurredAt', 'version', 'executionId']) {\n  if (body[f] === undefined) throw new Error('not an ECMS event envelope: missing ' + f);\n}\n\n// The workflow engine mirrors these names with a TRANSITION payload (EVENT_MULTI_PUBLISHER);\n// only the entity variant carries offerId, so anything else is not ours to act on.\nif (!body.payload || !body.payload.offerId) return [];\n\nconst state = $getWorkflowStaticData('global');\nstate.seen = Array.isArray(state.seen) ? state.seen : [];\nif (state.seen.includes(body.eventId)) return [];\nstate.seen.push(body.eventId);\nif (state.seen.length > 500) state.seen = state.seen.slice(-500);\n\nreturn [{ json: body }];"
          }
        },
