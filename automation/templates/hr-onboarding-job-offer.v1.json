        {
          "id": "acc-compose",
          "name": "Compose onboarding pack",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [1340, -80],
          "notes": "Formatting only. No business decision is taken here - both inputs came from ECMS.",
          "parameters": {
            "mode": "runOnceForAllItems",
            "jsCode": "const offerRes = $('Read offer (accepted)').first().json;\nconst offer = offerRes.data || offerRes;\nconst typesRes = $input.first().json;\nconst types = typesRes.data || typesRes.items || typesRes;\nconst list = Array.isArray(types) ? types : [];\n\nconst required = list.filter((t) => t && t.isRequired !== false);\nconst lines = required.map((t, i) => {\n  const label = t.name && (t.name.ar || t.name.en) ? (t.name.ar || t.name.en) : t.key;\n  return (i + 1) + '. ' + label;\n});\n\nreturn [{\n  json: {\n    offerId: offer.id,\n    applicantId: $('Verify + Dedupe').first().json.payload.applicantId,\n    applicantCode: $('Verify + Dedupe').first().json.payload.applicantCode,\n    // The offer's startDate is the reporting date. It is required on every offer.\n    reportingDate: offer.startDate,\n    documentCount: required.length,\n    documentList: lines.join('\\n'),\n  },\n}];"
          }
        },
