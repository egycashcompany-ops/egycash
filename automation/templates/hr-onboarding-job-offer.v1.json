          "credentials": { "httpHeaderAuth": { "name": "ECMS Service Token" } },
          "parameters": {
            "method": "GET",
            "url": "={{ $('ECMS Config').first().json.ecmsApiBase }}/hr/job-offers/{{ $('Verify + Dedupe').first().json.payload.offerId }}",
