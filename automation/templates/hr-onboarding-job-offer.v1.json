            "jsonBody": "={{ JSON.stringify({ to: { applicantId: $('Verify + Dedupe').first().json.payload.applicantId }, templateKey: $('ECMS Config').first().json.offerTemplateKey, variables: { offerId: $('Verify + Dedupe').first().json.payload.offerId, reminder: true } }) }}",
