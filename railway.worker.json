{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w packages/contracts && npm run build -w apps/api"
  },
  "deploy": {
    "startCommand": "npm run start:worker -w apps/api",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
